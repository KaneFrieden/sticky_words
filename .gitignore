# Data: never committed, since it takes up too much space; scripts re-download and rebuild it
data/raw/*
data/intermediate/*
data/processed/*
!data/**/.gitkeep

# Large model files (fastText vectors, translation model)
*.bin
*.vec
models/

# Machine-specific settings
env.sh
.env

# Python artifacts
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Figures are regenerated by scripts, not commited. ´.gitkeep´ ensures dir is tracked though. 
figures/*
!figures/.gitkeep

# LaTeX build files
report/*.aux
report/*.log
report/*.out
report/*.toc

# All Editor / OS files
.vscode/
.DS_Store
